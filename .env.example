# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (Supabase / PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=
SQL_HOST=
SQL_PORT=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_SSL=

# ─────────────────────────────────────────────────────────────────────────────
# Application & Auth (Backend — set in Render dashboard)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_ALERT_EMAIL=
FIREBASE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment URLs
# FRONTEND_URL  → your Vercel URL, e.g. https://your-app.vercel.app
#                 Set this in Render dashboard for CORS to work.
# VITE_API_URL  → your Render backend URL, e.g. https://slice-and-fire-backend.onrender.com
#                 Set this in Vercel dashboard (Environment Variables → Production).
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Payment Gateway (Razorpay)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Email / SMTP Alerts
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_USER=
EMAIL_PASS=
